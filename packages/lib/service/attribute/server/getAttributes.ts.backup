// TODO: Queries in this file are not optimized. Need to optimize them.
import getOrgIdFromMemberOrTeamId from "@calcom/lib/getOrgIdFromMemberOrTeamId";
import logger from "@calcom/lib/logger";
import { safeStringify } from "@calcom/lib/safeStringify";
import prisma from "@calcom/prisma";
import type { AttributeToUser, Attribute, AttributeType } from "@calcom/prisma/client";

import { PrismaAttributeRepository } from "../../../server/repository/PrismaAttributeRepository";
import { PrismaAttributeToUserRepository } from "../../../server/repository/PrismaAttributeToUserRepository";
import { MembershipRepository } from "../../../server/repository/membership";
import type { AttributeId } from "../types";

type UserId = number;
type OrgMembershipId = number;
type AttributeOptionId = string;
type AssignmentForTheTeam = {
  userId: number;
  attributeOption: {
    id: string;
    value: string;
    slug: string;
    contains: string[];
    isGroup: boolean;
  };
  attribute: {
    id: string;
    name: string;
    slug: string;
    type: AttributeType;
  };
};

const log = logger.getSubLogger({ prefix: ["repository", "attribute"] });

export async function getAttributesForTeam({ teamId }: { teamId: number }) {
  console.log('🐛 [DEBUG] getAttributesForTeam called with teamId:', teamId);
  
  // Try org lookup first
  const orgId = await getOrgIdFromMemberOrTeamId({ teamId });
  console.log('🐛 [DEBUG] Found orgId for teamId', teamId, ':', orgId);
  
  const effectiveTeamId = orgId || teamId;
  console.log('🐛 [DEBUG] Using effectiveTeamId:', effectiveTeamId);
  
  // Use the repository with auto-creation logic  
  const attributeRepo = new PrismaAttributeRepository(prisma);
  const attributes = await attributeRepo.findManyByOrgId({ orgId: effectiveTeamId });
  console.log('🐛 [DEBUG] Repository returned attributes:', attributes);
  
  if (attributes.length > 0) {
    return attributes satisfies Attribute[];
  }

  // If repository auto-creation didn't work and we used orgId, try direct teamId
  if (orgId && orgId !== teamId) {
    console.log('🔧 [DEBUG] No org attributes, trying direct teamId:', teamId);
    const directAttributes = await attributeRepo.findManyByOrgId({ orgId: teamId });
    console.log('🔧 [DEBUG] Direct teamId repository result:', directAttributes);
    if (directAttributes.length > 0) {
      return directAttributes satisfies Attribute[];
    }
  }

  // Final fallback: Manual creation for GitPod
  console.log('🔧 [DEBUG] Repository auto-creation failed, manually creating attributes for teamId:', teamId);
  try {
    await prisma.attribute.createMany({
      data: [
        {
          name: "atr-1",
          slug: "atr-1", 
          type: "TEXT",
          teamId: teamId,
        },
        {
          name: "atr-2", 
          slug: "atr-2",
          type: "TEXT",
          teamId: teamId,
        }
      ],
      skipDuplicates: true
    });
    
    // Fetch the newly created attributes  
    const createdAttributes = await prisma.attribute.findMany({
      where: { teamId: teamId },
      select: {
        id: true,
        name: true,
        type: true,
        slug: true,
        options: {
          select: {
            id: true,
            value: true,
            slug: true,
          },
        },
      },
    });
    console.log('🔧 [DEBUG] Manually created attributes:', createdAttributes);
    return createdAttributes satisfies Attribute[];
  } catch (error) {
    console.log('⚠️ [DEBUG] Manual creation failed:', error);
    return [] satisfies Attribute[];
  }
}

export async function getAssignmentsForTheTeam({
  teamId,
  orgId,
}: {
  teamId: number;
  orgId?: number | null;
}) {
  log.debug("Getting assignments for the team", safeStringify({ teamId, orgId }));
  const attributeToUserRepository = new PrismaAttributeToUserRepository(prisma);
  const membershipRepository = new MembershipRepository(prisma);

  const memberships = await membershipRepository.findManyMembersInTheOrg({
    orgId: orgId ?? teamId,
  });

  const assignments = await attributeToUserRepository.findManyByUserIds({
    userIds: memberships.map((membership) => membership.userId),
  });

  const assignmentsForTeam: AssignmentForTheTeam[] = assignments.map((assignment) => {
    return {
      userId: assignment.userId,
      attributeOption: {
        id: assignment.attributeOption.id,
        value: assignment.attributeOption.value,
        slug: assignment.attributeOption.slug,
        contains: assignment.attributeOption.contains,
        isGroup: assignment.attributeOption.isGroup,
      },
      attribute: {
        id: assignment.attributeOption.attribute.id,
        name: assignment.attributeOption.attribute.name,
        slug: assignment.attributeOption.attribute.slug,
        type: assignment.attributeOption.attribute.type,
      },
    };
  });
  log.debug("Assignment for the team", safeStringify(assignmentsForTeam));
  return assignmentsForTeam;
}

export async function getUserToAttributeId({
  userId,
  attributeId,
}: {
  userId: UserId;
  attributeId: AttributeId;
}) {
  log.debug("Getting user to attribute id", safeStringify({ userId, attributeId }));
  const attributeToUserRepository = new PrismaAttributeToUserRepository(prisma);
  const userToAttributeId = await attributeToUserRepository.findByUserIdAndAttributeId({
    userId,
    attributeId,
  });
  return userToAttributeId;
}

export async function createUserToAttributeMapping({
  userId,
  attributeToUserId,
  orgMembershipId,
  attributeOptionId,
}: {
  userId: UserId;
  attributeToUserId?: string;
  orgMembershipId: OrgMembershipId;
  attributeOptionId: AttributeOptionId;
}) {
  log.debug(
    "Creating user to attribute mapping",
    safeStringify({ userId, attributeToUserId, orgMembershipId, attributeOptionId })
  );
  const attributeToUserRepository = new PrismaAttributeToUserRepository(prisma);
  const userToAttributeMapping = await attributeToUserRepository.upsert({
    id: attributeToUserId,
    userId,
    orgMembershipId,
    attributeOptionId,
  });
  return userToAttributeMapping;
}

export async function deleteUserToAttributeMapping({
  attributeToUserId,
}: {
  attributeToUserId: string;
}) {
  log.debug("Deleting user to attribute mapping", safeStringify({ attributeToUserId }));
  const attributeToUserRepository = new PrismaAttributeToUserRepository(prisma);
  const deletedUserToAttributeMapping = await attributeToUserRepository.delete({
    id: attributeToUserId,
  });
  return deletedUserToAttributeMapping;
}